---
import PageLayout from '../layouts/PageLayout.astro';
import { Chevrons, Asterisk, Globe, Slashes } from '../components/shapes';
import { FloatingShape } from '../components/motion/FloatingShape';
---
<PageLayout title="Page not found | GDG on Campus IBA" description="This page wandered off campus. Head home or explore GDG on Campus IBA events." robots="noindex, follow" theme="pink">
  <section class="not-found theme-pink" aria-labelledby="not-found-title">
    <div class="site-container not-found-layout">
      <p class="not-found-kicker">GDG ON CAMPUS IBA / PAGE NOT FOUND</p>
      <div class="not-found-code" aria-hidden="true"><span>4</span><span class="not-found-zero"><Chevrons monochrome width={100} height={60}/></span><span>4</span></div>
      <h1 id="not-found-title">This page wandered <strong>off campus.</strong></h1>
      <p>The link may have changed, but there’s plenty to explore.</p>
      <div class="not-found-actions"><a href="/" class="brand-button">Back to Home <span aria-hidden="true">↗</span></a><a href="/events" class="brand-button brand-button--ghost">Explore Events <span aria-hidden="true">→</span></a></div>
      <div class="not-found-shapes" aria-hidden="true"><FloatingShape client:visible depth={6}><Asterisk variant="outline" width={76} height={76}/></FloatingShape><FloatingShape client:visible depth={8} rotate={false}><Globe variant="outline" width={76} height={76}/></FloatingShape><FloatingShape client:visible depth={6}><Slashes variant="outline" width={76} height={76}/></FloatingShape></div>
    </div>
  </section>
</PageLayout>
<style>
.not-found{background:#f8d8d8;padding:150px 0 80px;overflow:clip;text-align:center}.not-found-layout{max-width:900px}.not-found-kicker{font:11px var(--font-mono);letter-spacing:.1em}.not-found-code{display:flex;align-items:center;justify-content:center;gap:20px;margin:24px 0;font-size:clamp(100px,20vw,240px);line-height:1;font-family:var(--font-display)}.not-found-zero{width:clamp(90px,17vw,200px);aspect-ratio:1;display:grid;place-items:center;background:#ff7daf;border:1.5px solid #1e1e1e;border-radius:50%}.not-found-zero :global(svg){width:55%;height:auto}.not-found h1{font-size:clamp(32px,4.5vw,60px);line-height:1.15;letter-spacing:-.04em;margin:24px 0}.not-found h1 strong{font-weight:700}.not-found p:not(.not-found-kicker){line-height:1.8;max-width:500px;margin:auto}.not-found-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin:32px 0 40px}.not-found-actions a{gap:12px}.not-found-shapes{display:flex;justify-content:center;gap:36px}.not-found-actions a:focus-visible{outline:3px solid #4285f4;outline-offset:4px}@media(max-width:767px){.not-found{padding:140px 0 56px}.not-found-code{gap:12px}.not-found-shapes{gap:24px}.not-found-shapes :global(svg){width:56px;height:56px}}
</style>
