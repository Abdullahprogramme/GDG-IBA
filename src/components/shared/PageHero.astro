---
import { HeroTitle, HeroShapes, type HeroShapeName } from './HeroScene';
import ScallopDivider from './ScallopDivider.astro';
import { themes, type ThemeName } from '../shapes/themes';
interface Props { title:string; emphasis?:string; subtitle?:string; label?:string; number?:string; theme?:ThemeName; shapes?:HeroShapeName[] }
const {title,emphasis=title.split(' ').at(-1)??title,subtitle,label='GDG on Campus IBA',number='01',theme='blue',shapes}=Astro.props;
---
<section class={`page-hero theme-${theme}`} style={`background:${themes[theme].pastel}`}>
 <div class="site-container page-hero-grid"><div><p class="page-hero-label">{number} / {label}</p><HeroTitle title={title} emphasis={emphasis}/>{subtitle&&<p class="page-hero-subtitle">{subtitle}</p>}</div><HeroShapes client:media="(min-width: 768px)" theme={theme} shapes={shapes}/></div>
 <ScallopDivider from={theme}/>
</section>
<style is:global>
.page-hero{padding-top:160px;overflow:hidden}.page-hero-grid{display:grid;grid-template-columns:2fr 1fr;align-items:center;gap:40px;padding-bottom:80px}.page-hero-label{font-family:var(--font-mono);font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin-bottom:24px}.page-hero-title{font-size:clamp(42px,6.5vw,96px);font-weight:400;line-height:1.08;letter-spacing:-.045em}.page-hero-title strong{font-weight:700}.page-hero-subtitle{font-size:clamp(16px,2vw,22px);line-height:1.6;max-width:650px;margin-top:24px}.page-hero-shapes{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px}.page-hero-shapes>div:first-child{flex-basis:100%;display:flex;justify-content:center}@media(max-width:767px){.page-hero-grid{grid-template-columns:1fr;gap:32px}.page-hero-shapes{flex-wrap:nowrap}.page-hero-shapes>div:first-child{flex-basis:auto}.page-hero-shapes svg{width:64px;height:64px}}
</style>

<style is:global>
.page-hero-title>span{animation:page-title-enter .5s cubic-bezier(.22,1,.36,1) both}@keyframes page-title-enter{from{transform:translateY(20px)}to{transform:translateY(0)}}
</style>
